#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
toolchain=${OCEAN_LEAN_ROOT:-$(elan run leanprover/lean4:v4.35.0 lean --print-prefix)}
mkdir -p bin .ocean/lake
work=$PWD/.ocean/lake
cp -R "$toolchain/src/lean/lake/." "$work/"
chmod -R u+w "$work"
python3 internal/adapter/patch.py "$work"
cat > "$work/lakefile.toml" <<'TOML'
name = "oceanLake"
defaultTargets = ["lake"]
[[lean_lib]]
name = "Lake"
[[lean_exe]]
name = "lake"
root = "LakeMain"
supportInterpreter = true
TOML
"$toolchain/bin/lake" --dir="$work" --no-cache build
ln -sfn ../.ocean/lake/.lake/build/bin/lake bin/ocean-lake
${GO:-go} build -o bin/ocean .
ln -sfn ocean bin/ocean-worker
