#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
toolchain=${FLAKE_LEAN_ROOT:-$(elan run leanprover/lean4:v4.35.0 lean --print-prefix)}
mkdir -p bin .flake/lake
work=$PWD/.flake/lake
cp -R "$toolchain/src/lean/lake/." "$work/"
chmod -R u+w "$work"
python3 internal/adapter/patch.py "$work"
cat > "$work/lakefile.toml" <<'TOML'
name = "flakeLake"
defaultTargets = ["lake"]
[[lean_lib]]
name = "Lake"
[[lean_exe]]
name = "lake"
root = "LakeMain"
supportInterpreter = true
TOML
"$toolchain/bin/lake" --dir="$work" --no-cache build
ln -sfn ../.flake/lake/.lake/build/bin/lake bin/flake-lake
${GO:-go} build -o bin/flake .
ln -sfn flake bin/flake-worker
